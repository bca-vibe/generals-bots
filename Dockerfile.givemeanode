FROM nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

WORKDIR /workspace
COPY . /workspace

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e '.[train,tracking]' \
    && pip install --no-cache-dir --upgrade 'jax[cuda12]'

# Execute the CPU-only supervisor as a file. ``python -m`` imports
# ``generals.training`` first, whose public API imports JAX and causes the
# eight-GPU parent to reserve most of GPU 0 before its four-GPU workers start.
CMD ["python", "generals/training/ab_supervisor.py"]
